{
  "name": "tiktok-cleaner-pro",
  "version": "1.0.0",
  "private": true,
  "description": "TikTok Cleaner Pro — Smart Repost & Like Manager (unofficial Chrome extension, Manifest V3)",
  "type": "module",
  "scripts": {
    "icons": "node scripts/gen-icons.mjs",
    "build": "node scripts/gen-icons.mjs && tsc --noEmit && node scripts/build.mjs",
    "build:fast": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "zip": "node scripts/zip.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.1.0",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.24.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
